{
  "buildCommand": "npm install && npm run build",
  "installCommand": "npm install",
  "framework": "vite",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/member/:path*",
      "destination": "https://app.glasspay.app/member/:path*",
      "permanent": false
    },
    { "source": "/invite", "destination": "https://app.glasspay.app/invite", "permanent": false },
    { "source": "/invites", "destination": "https://app.glasspay.app/invites", "permanent": false },
    { "source": "/sign-up", "destination": "https://app.glasspay.app/sign-up", "permanent": false },
    { "source": "/sign-in", "destination": "https://app.glasspay.app/sign-in", "permanent": false },
    {
      "source": "/forgot-password",
      "destination": "https://app.glasspay.app/forgot-password",
      "permanent": false
    },
    {
      "source": "/reset-password",
      "destination": "https://app.glasspay.app/reset-password",
      "permanent": false
    },
    {
      "source": "/check-email",
      "destination": "https://app.glasspay.app/check-email",
      "permanent": false
    },
    {
      "source": "/onboarding/:path*",
      "destination": "https://app.glasspay.app/onboarding/:path*",
      "permanent": false
    },
    {
      "source": "/dashboard/:path*",
      "destination": "https://app.glasspay.app/dashboard/:path*",
      "permanent": false
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self' https://www.upwork.com https://upwork.com"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self' https://www.upwork.com https://upwork.com; form-action 'self'; script-src 'self' https://client.crisp.chat; style-src 'self' 'unsafe-inline' https://client.crisp.chat; img-src 'self' data: blob: https://res.cloudinary.com; font-src 'self' data: https://client.crisp.chat; connect-src 'self' https://res.cloudinary.com https://*.ingest.sentry.io https://*.sentry.io https://va.vercel-scripts.com https://*.crisp.chat wss://*.relay.crisp.chat wss://*.relay.rescue.crisp.chat; frame-src 'self' https://client.crisp.chat; worker-src 'self' blob: https://*.crisp.chat; manifest-src 'self'; media-src 'self' blob:; upgrade-insecure-requests"
        },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self \"https://*.crisp.chat\"), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*\\.png|.*\\.jpg|.*\\.jpeg|.*\\.webp|.*\\.svg|.*\\.ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
